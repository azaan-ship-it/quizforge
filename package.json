{
  "name": "quizforge",
  "version": "1.2.0",
  "description": "QuizForge by ByteForge Studios \u2014 live quiz games with five modes, accounts, Forgelings, AI question sets and custom quizzes with pictures.",
  "main": "desktop/main.js",
  "author": "ByteForge Studios",
  "license": "MIT",
  "scripts": {
    "start": "node server/index.js",
    "desktop": "electron .",
    "dist": "electron-builder --win --dir"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.byteforge.quizforge",
    "productName": "QuizForge",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "desktop/**",
      "server/**",
      "public/**",
      "data/**",
      "package.json",
      "assets/**"
    ],
    "win": {
      "target": "dir",
      "icon": "assets/icon.ico"
    }
  }
}